# Copy this file to .env at the project root before running ./run.sh.
# Keep real credentials only in .env. Never commit real secrets.

# Backend runtime
SPRING_APPLICATION_NAME=Propease-BE
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Backend database
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/propease_db
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=your_database_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Backend uploads
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB

# Frontend runtime
FRONTEND_PORT=3000
REACT_APP_API_BASE_URL="http://localhost:8080"
REACT_APP_ENABLE_PAYMENTS=true

# Frontend public external URLs
REACT_APP_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
REACT_APP_WHATSAPP_BASE_URL="https://wa.me"
REACT_APP_PROPERTY_PLACEHOLDER_IMAGE_URL="https://via.placeholder.com/250x200?text=Property"
REACT_APP_PROFILE_AVATAR_URL="https://cdn-icons-png.flaticon.com/512/847/847969.png"
REACT_APP_FONT_CSS_URL="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap"
REACT_APP_BOOTSTRAP_CSS_URL="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
REACT_APP_BOOTSTRAP_JS_URL="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
